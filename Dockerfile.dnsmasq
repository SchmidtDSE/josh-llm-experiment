# Per-run passive DNS observation sidecar. Builds `fortree:dnsmasq`.
#
#   docker build -f Dockerfile.dnsmasq -t fortree:dnsmasq .
#
# Deliberately a SEPARATE Dockerfile from the main one — this image is
# structurally unrelated to base/agent/scorer:
#
#   - Built FROM alpine, not FROM base. Shares zero layers with the
#     agent/scorer images. ~5 MB total vs base's ~1.5 GB.
#   - Has no python, java, josh, opencode, or scientific stack. The only
#     payload is dnsmasq + a config file. Minimal surface is the point.
#
# History (Phase 6 refactor — see IMPLEMENTATION_PLAN.md §K8s execution):
# this image previously installed `iptables` + `ipset` and shipped a
# `sidecar-init.sh` that set up a kernel-level OUTPUT-chain REJECT for
# anything not in the dnsmasq-populated `allowed_dst` ipset. The k8s
# Pod model can't express the per-run docker-bridge + CAP_NET_ADMIN
# shape that enforcement required, so the egress boundary was relaxed
# from *enforced* to *monitored*. The image now does just one thing:
# log every DNS query the agent issues, so `dns.log` remains the
# post-hoc evidence record for what hosts the agent reached. The
# validity argument now leans on opencode's `trajectory.jsonl` +
# `dns.log` together; see EXPERIMENTAL_DESIGN.md §Egress observability.
#
# Pod wiring (PR5): the Pod sets `dnsPolicy: None` +
# `dnsConfig.nameservers: [<sidecar-IP>]` so the agent's resolver
# routes through this sidecar. No `CAP_NET_ADMIN`, no shared netns.

FROM alpine:3.20
RUN apk add --no-cache dnsmasq
COPY orchestration/dnsmasq.conf /etc/dnsmasq.conf
EXPOSE 53/udp 53/tcp

# `pidof dnsmasq` only goes nonzero before dnsmasq has bound to :53;
# once it's up, queries are accepted. Tight cadence so the orchestrator
# wait is short — startup is sub-second on a warm host.
HEALTHCHECK --interval=1s --timeout=2s --start-period=1s --retries=5 \
  CMD pidof dnsmasq >/dev/null || exit 1

# ENTRYPOINT = dnsmasq alone (not `dnsmasq -k`) so that the conventional
# `docker run --rm fortree:dnsmasq --test` README sanity check keeps
# working. CMD supplies the normal-serving args; override at run time
# for anything else.
ENTRYPOINT ["dnsmasq"]
CMD ["-k"]
