#!/usr/bin/env bash
# ForeverTree simulation entrypoint.
#
# Contract: this script runs preprocessing + simulation + CSV emission
# end-to-end. The scorer invokes it as `./run.sh` (with N_REPLICATES=100
# set in the env, so the canonical 100-replicate workload runs once),
# then reads `./output/`. Replicate count is parameterised through the
# N_REPLICATES env var — default 2 below for fast iteration during
# development.

set -euo pipefail
cd "$(dirname "$0")"
N_REPLICATES="${N_REPLICATES:-2}"

