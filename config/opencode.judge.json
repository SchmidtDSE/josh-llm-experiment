{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "agent": {
    "reviewer": {
      "model": "${RESOLVED_JUDGE_MODEL_ID}",
      "tools": {
        "read":     true,
        "write":    false,
        "edit":     false,
        "glob":     true,
        "grep":     true,
        "bash":     false,
        "webfetch": false,
        "task":     false
      },
      "permission": {
        "external_directory": "allow"
      }
    }
  }
}
