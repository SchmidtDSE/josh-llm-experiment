{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "agent": {
    "coder": {
      "model": "openrouter/${RESOLVED_MODEL_ID}",
      "tools": {
        "read":     true,
        "write":    true,
        "edit":     true,
        "glob":     true,
        "grep":     true,
        "bash":     true,
        "webfetch": true
      },
      "permission": {
        "bash": {
          "./run.sh":    "allow",
          "./run.sh *":  "allow",
          "ls":          "allow",
          "ls *":        "allow",
          "cat":         "allow",
          "cat *":       "allow",
          "head":        "allow",
          "head *":      "allow",
          "tail":        "allow",
          "tail *":      "allow",
          "find":        "allow",
          "find *":      "allow",
          "wc":          "allow",
          "wc *":        "allow",
          "tree":        "allow",
          "tree *":      "allow",
          "python":      "allow",
          "python *":    "allow",
          "python3":     "allow",
          "python3 *":   "allow",
          "java":        "allow",
          "java *":      "allow",
          "josh":        "allow",
          "josh *":      "allow",
          "mkdir":       "allow",
          "mkdir *":     "allow",
          "*":           "deny"
        },
        "webfetch": "allow"
      }
    }
  }
}
