{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OLLAMA_HOST}/v1"
      },
      "models": {
        "qwen2.5-coder:1.5b": {},
        "qwen2.5-coder:7b": {}
      }
    }
  },
  "agent": {
    "coder": {
      "model": "${RESOLVED_MODEL_ID}",
      "tools": {
        "read":     true,
        "write":    true,
        "edit":     true,
        "glob":     true,
        "grep":     true,
        "bash":     true,
        "webfetch": true,
        "task":     false
      },
      "permission": {
        "bash":               "allow",
        "webfetch":           "allow",
        "external_directory": "allow"
      }
    }
  }
}
