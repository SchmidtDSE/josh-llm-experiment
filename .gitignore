.claude
.env
.env.local

runs/
results/manifest.jsonl.tmp
*.pyc
__pycache__/
.DS_Store

# Analysis outputs — reproducible from analysis/aggregate.py +
# analysis/headline.ipynb against the per-cell artefacts in runs/.
# Source of truth is the notebook; rendered figures and the
# aggregated CSV are derived artefacts.
analysis/aggregated.csv
analysis/figures/
analysis/.ipynb_checkpoints/

# K8s manifests rendered per-batch by orchestration/render_jobs.py — derived
# artefacts, regenerable from the templates. Source of truth is the template +
# CLI args.
orchestration/rendered/

# Matrix CSVs generated interactively by analysis/headline-batch-recipe.ipynb
# from the aggregated state of each batch. Re-runnable from the notebook.
orchestration/matrix-rerep.csv
orchestration/matrix-stage2.csv

# pixi environments
.pixi/*
!.pixi/config.toml

# Josh fat jars fetched by `pixi run get-jars` (scripts/get_jars.py). Large
# rolling binaries; source of truth is joshsim.org/dist/<branch>, pinned by
# the recorded .sha256.
jar/
