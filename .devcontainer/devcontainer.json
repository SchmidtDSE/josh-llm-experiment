{
    "name": "josh-llm-experiment",
    "image": "ghcr.io/prefix-dev/pixi:0.66.0-bullseye-slim",
    "features": {
        "ghcr.io/devcontainers/features/common-utils": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": false,
            "dockerDashComposeVersion": "v2"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        },
        // GKE auth plugin is installed by .devcontainer/post-create.sh, not
        // by this feature: v1.0.1's plugin step targets the legacy
        // google-cloud-sdk-* package, which no-ops against the current
        // google-cloud-cli gcloud. Left off here to avoid the misleading
        // (silently-failing) attempt.
        "ghcr.io/dhoeric/features/google-cloud-cli:1": {
            "installGkeGcloudAuthPlugin": false
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "version": "latest",
            "helm": "none",
            "minikube": "none"
        }
    },
    "runArgs": ["--privileged"],
    "remoteUser": "root",
    "postCreateCommand": ".devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker",
                "ms-kubernetes-tools.vscode-kubernetes-tools"
            ]
        }
    }
}
