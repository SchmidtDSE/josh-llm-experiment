FROM fortree-base:latest AS scorer

# Scorer-only delta: an entrypoint that dispatches to harness/run_metrics.py.
# Phase 2 will COPY harness/ in; until then the entrypoint exits with a clear
# error if invoked.

COPY entrypoint-scorer.sh /opt/entrypoint-scorer.sh
RUN chmod +x /opt/entrypoint-scorer.sh

# Phase 2 will uncomment once harness/ exists.
# COPY harness /opt/harness
