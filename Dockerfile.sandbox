FROM python:3.11-slim-trixie AS sandbox

# Pinned versions of the agent-side tooling.
ARG OPENCODE_VERSION=1.14.50
ARG OPENSHELL_VERSION=0.0.36
ARG JOSH_JAR_URL=https://joshsim.org/dist/main/joshsim-fat.jar

ENV DEBIAN_FRONTEND=noninteractive

# Base apt: curl/git/jq/unzip plus Adoptium prereqs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      gnupg \
      jq \
      unzip \
      wget \
    && rm -rf /var/lib/apt/lists/*

# Eclipse Temurin (OpenJDK 17). Trixie dropped distro-provided openjdk-17, so we
# add Adoptium's apt repo and install temurin-17-jre.
RUN mkdir -p /etc/apt/keyrings \
    && wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && CODENAME=$(awk -F= '/^VERSION_CODENAME/{print $2}' /etc/os-release) \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb ${CODENAME} main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update && apt-get install -y --no-install-recommends temurin-17-jre \
    && rm -rf /var/lib/apt/lists/*

# Josh CLI: same fat jar + wrapper as the scorer image. Duplicated rather than
# inherited because scorer and sandbox sit on different Debian bases.
RUN mkdir -p /opt/josh \
    && curl -fSL "$JOSH_JAR_URL" -o /opt/josh/joshsim-fat.jar \
    && sha256sum /opt/josh/joshsim-fat.jar > /opt/josh/joshsim-fat.jar.sha256 \
    && cat /opt/josh/joshsim-fat.jar.sha256

RUN printf '#!/usr/bin/env bash\nset -euo pipefail\nif [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then\n  cat /opt/josh/joshsim-fat.jar.sha256\n  exit 0\nfi\nexec java -jar /opt/josh/joshsim-fat.jar "$@"\n' > /usr/local/bin/josh \
    && chmod +x /usr/local/bin/josh

# Python scientific stack — same pins as the scorer image so reference and
# agent code execute under identical Python versions.
COPY config/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt

# uv: Astral's single-binary Python tool installer.
RUN pip install --no-cache-dir uv

# OpenShell: kernel-level sandbox runtime. Alpha; pinned strictly. Requires
# glibc 2.39+ (hence the trixie base).
RUN uv tool install "openshell==${OPENSHELL_VERSION}" \
    && ln -s /root/.local/bin/openshell /usr/local/bin/openshell

# opencode: official install script supports --version pinning.
RUN curl -fsSL https://opencode.ai/install | bash -s -- --version "${OPENCODE_VERSION}" --no-modify-path \
    && ln -s /root/.opencode/bin/opencode /usr/local/bin/opencode

COPY entrypoint-sandbox.sh /opt/entrypoint-sandbox.sh
RUN chmod +x /opt/entrypoint-sandbox.sh

WORKDIR /sandbox
