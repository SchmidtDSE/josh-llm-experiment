FROM python:3.11-slim-trixie AS base

# Shared base for fortree-scorer and fortree-sandbox. Provides Python 3.11,
# OpenJDK 17 (Eclipse Temurin via Adoptium apt repo), the Josh CLI, and the
# pinned scientific stack. The two leaf images differ only in entrypoint and
# (for the sandbox) the agent-side tooling layer.
#
# Trixie is required for OpenShell, which ships manylinux_2_39 wheels (glibc
# 2.39+); bookworm provides only 2.36. The scorer doesn't strictly need
# OpenShell, but using one base for both keeps reference and agent code
# executing under identical environments — that is the spec the rest of the
# harness expects.

ARG JOSH_JAR_URL=https://joshsim.org/dist/main/joshsim-fat.jar

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      gnupg \
      jq \
      unzip \
      wget \
    && rm -rf /var/lib/apt/lists/*

# Eclipse Temurin (OpenJDK 17). Trixie dropped distro-provided openjdk-17, so
# we add Adoptium's apt repo.
RUN mkdir -p /etc/apt/keyrings \
    && wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && CODENAME=$(awk -F= '/^VERSION_CODENAME/{print $2}' /etc/os-release) \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb ${CODENAME} main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update && apt-get install -y --no-install-recommends temurin-17-jre \
    && rm -rf /var/lib/apt/lists/*

# Josh CLI: rolling main fat jar. sha256 captured at build time is the
# reproducibility anchor since SchmidtDSE/josh has no tagged releases.
RUN mkdir -p /opt/josh \
    && curl -fSL "$JOSH_JAR_URL" -o /opt/josh/joshsim-fat.jar \
    && sha256sum /opt/josh/joshsim-fat.jar > /opt/josh/joshsim-fat.jar.sha256 \
    && cat /opt/josh/joshsim-fat.jar.sha256

RUN printf '#!/usr/bin/env bash\nset -euo pipefail\nif [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then\n  cat /opt/josh/joshsim-fat.jar.sha256\n  exit 0\nfi\nexec java -jar /opt/josh/joshsim-fat.jar "$@"\n' > /usr/local/bin/josh \
    && chmod +x /usr/local/bin/josh

# Python scientific stack.
COPY config/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt

WORKDIR /sandbox
