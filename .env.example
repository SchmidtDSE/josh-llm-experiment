# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=

# Local-LLM (Ollama) base URL. Only required when MODEL is an ollama-* short
# name; ignored for OpenRouter models. On Docker Desktop / macOS, the agent
# container reaches the host via host.docker.internal; in CI it talks to a
# sidecar ollama container at http://ollama:11434.
OLLAMA_HOST=http://localhost:11434

# Optional: launcher backstops.
# WALL_CLOCK_BACKSTOP_SEC: hard ceiling on agent wall time (default 1800).
# IDLE_THRESHOLD_SEC: kill if no new trajectory event for this many seconds
# (default 120). Catches silent LLM-stream stalls distinct from wall budget.
# WALL_CLOCK_BACKSTOP_SEC=1800
# IDLE_THRESHOLD_SEC=120
