# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=

# Local-LLM (Ollama) base URL. Only required when MODEL is an ollama-* short
# name; ignored for OpenRouter models. On Docker Desktop / macOS, the agent
# container reaches the host via host.docker.internal; in CI it talks to a
# sidecar ollama container at http://ollama:11434.
OLLAMA_HOST=http://localhost:11434

# Optional: launcher backstops.
# WALL_CLOCK_BACKSTOP_SEC: hard ceiling on agent wall time (default 1800).
#   Covers the full 8-step multi-invocation chain, not a single step —
#   individual steps may legitimately take very different lengths.
# IDLE_THRESHOLD_SEC: kill if no new trajectory event for this many seconds
# (default 120). Catches silent LLM-stream stalls distinct from wall budget.
# WALL_CLOCK_BACKSTOP_SEC=1800
# IDLE_THRESHOLD_SEC=120

# Optional: multi-invocation failure mode.
# FAIL_FAST_ON_STEP_ERROR=false → production behaviour: if one of the 8
#   opencode invocations exits non-zero, log it in the per-step
#   step_meta.json and continue to the next step. Partial completion is
#   data, not failure.
# FAIL_FAST_ON_STEP_ERROR=true  → pipeline-verification behaviour: the
#   first non-zero opencode exit aborts the loop immediately. Use during
#   development / CI to surface broken plumbing fast instead of silently
#   degrading through the remaining steps.
FAIL_FAST_ON_STEP_ERROR=false

# Archival to S3-compatible object storage (GCS via S3 interop API in our
# setup). Consumed by orchestration/upload_batch.sh, which runs host-side
# after a batch completes — the agent container has no awareness of these
# vars and never sees the credentials.
#
# Required by upload_batch.sh:
#   MINIO_ENDPOINT     https://storage.googleapis.com for GCS interop
#   MINIO_BUCKET       destination bucket name
#   MINIO_ACCESS_KEY   HMAC access key
#   MINIO_SECRET_KEY   HMAC secret
# Optional:
#   MINIO_PREFIX       object-key prefix appended after bucket
#                      (default: empty; batch dir name is always appended)
# MINIO_ENDPOINT=https://storage.googleapis.com
# MINIO_BUCKET=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_PREFIX=

# Fuzzy LLM-judge (host-side, post-scoring). Default: enabled. Disable
# per-batch via `launch_batch.py --skip-fuzzy-evaluation`. The judge
# reuses OPENROUTER_API_KEY above — no new credential needed.
#
# JUDGE_MODEL: short name from config/models.yaml. Default: codex
#   (→ openai/gpt-5-codex). Pick a different short name for a
#   second-judge sanity pass against the same batch.
# JUDGE_MODEL=codex
